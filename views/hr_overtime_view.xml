<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_overtime_view_list" model="ir.ui.view">
            <field name="name">hr.overtime.view.list</field>
            <field name="model">hr.overtime</field>
            <field name="arch" type="xml">
                <list string="Overtime">
                    <field name="date" width="33%"/>
                    <field name="total_time" width="33%"/>
                    <field name="employee_id" width="33%"/>
                </list>
            </field>
        </record>

        <record id="hr_overtime_view_form" model="ir.ui.view">
            <field name="name">hr.overtime.view.form</field>
            <field name="model">hr.overtime</field>
            <field name="arch" type="xml">
                <form string="Overtime">
                    <header>
                        <button name="change_state" type="object" string="Approve" class="oe_highlight"
                                context="{'state': 'approved'}" invisible="state != 'draft' or is_overtime_approver"
                                groups="cds_hr_overtime.hr_overtime_approver_group"/>
                        <button name="change_state" type="object" string="Pay" class="oe_highlight"
                                context="{'state': 'paid'}" invisible="state != 'approved'"
                                groups="cds_hr_overtime.hr_overtime_manager_group"/>
                            <button name="action_view_payment"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-money"
                                    invisible="payment_count == 0">
                                <field name="payment_count" widget="statinfo" string="Payment"/>
                            </button>
                                invisible="state != 'draft' or not is_overtime_approver"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="employee_id"/>
                            <h1>
                                <field name="employee_id" readonly="not is_overtime_manager or state != 'draft'"/>
                            </h1>
                        </div>

                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="type" readonly="state != 'draft'"/>
                            <field name="total_time" widget="float_time"/>
                        </group>

                        <notebook>
                            <page string="Overtime Lines" name="overtime_lines">
                                <field readonly="state != 'draft'"
                                       name="line_ids"
                                       widget="sol_o2m"
                                       mode="list"
                                       aggregated_fields="task_id,from_time,to_time">
                                    <list string="Overtime Lines"
                                          editable="bottom"
                                          limit="200">
                                        <field name="task_id" width="25%"/>
                                        <field name="date" width="25%"/>
                                        <field name="total_time" width="25%" sum="Total Time"/>
                                        <field name="from_time" width="25%" widget="float_time_selection" />
                                        <field name="to_time" width="25%" widget="float_time_selection" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_overtime_lines_form_view" model="ir.ui.view">
            <field name="name">hr.overtime.lines.form</field>
            <field name="model">hr.overtime.lines</field>
            <field name="arch" type="xml">
                <form string="Overtime Line">
                    <sheet>
                        <group>
                            <field name="task_id" readonly="overtime_id.state != 'draft'"/>
                            <field name="date" readonly="overtime_id.state != 'draft'"/>
                        </group>
                        <group>
                            <field name="from_time" widget="float_time" readonly="overtime_id.state != 'draft'"/>
                            <field name="to_time" widget="float_time" readonly="overtime_id.state != 'draft'"/>
                            <field name="total_time" readonly="1"/>
                        </group>
                        <group>
                            <field name="overtime_id" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_overtime_action" model="ir.actions.act_window">
            <field name="name">HR Overtime</field>
            <field name="res_model">hr.overtime</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem
                id="hr_overtime_root_menu"
                name="Overtime"
                web_icon="cds_hr_overtime,static/imgs/time.png"
                groups="cds_hr_overtime.hr_overtime_user_group"/>
        <menuitem
                id="hr_overtime_menu_item"
                name="Overtime"
                parent="hr_overtime_root_menu"
                action="hr_overtime_action"/>
    </data>
</odoo>